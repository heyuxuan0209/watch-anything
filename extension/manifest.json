{
  "manifest_version": 3,
  "name": "watch-anything · 待读队列",
  "version": "0.1.0",
  "description": "看到看不完的视频，点一下丢进待读队列，接着看你的。你的 agent 稍后把它读完。",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "丢进待读队列（watch-anything）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
